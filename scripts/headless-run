#!/usr/bin/env bash
# Run the game on a virtual X display (Xvfb) with software Vulkan (lavapipe):
# no window on your screen, no focus stealing. Drive it with scripts/brp.
set -euo pipefail
export VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.x86_64.json
exec xvfb-run -a -s "-screen 0 1280x720x24" cargo run "$@"
