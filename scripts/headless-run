#!/usr/bin/env bash
# Run the game on a virtual X display (Xvfb) with software Vulkan (lavapipe):
# no window on your screen, no focus stealing. Drive it with scripts/brp.
set -euo pipefail
# Own BRP port, so it never collides with a game the user is playing (which uses 15702).
export BRP_EXTRAS_PORT=${BRP_PORT:-15799}
# Silence: Xvfb only fakes the display; audio would otherwise hit the user's speakers.
export ALSA_CONFIG_PATH="$(dirname "$0")/alsa-null.conf"
export VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.x86_64.json
exec xvfb-run -a -s "-screen 0 1280x720x24" cargo run "$@"
