title = "HIM"
gain = 0.55
reverb = 0.42
room = 3.2

# ── Cues ────────────────────────────────────────────────────────────────────────

[[cue]]
name = "calm"
bpm = 92.0
chords = "Dm Dm Bb A"
fade = 0.7

[[cue]]
name = "fight"
bpm = 138.0
chords = "Dm Eb Dm A7b9"
fade = 0.08

[[cue]]
name = "win"
bpm = 92.0
chords = "D D"
fade = 0.3

[[cue]]
name = "lose"
bpm = 92.0
chords = "Dm Dm"
fade = 0.3

# ── Stems: calm ─────────────────────────────────────────────────────────────────

[[stem]]
name = "Low strings"
cue = "calm"
patch = "strings"
part = "r-12,r-5,r+12,2+12 _*15"

[[stem]]
name = "Celesta"
cue = "calm"
patch = "bell"
fader = { follow = "fall", from = 0.2, to = 0.6 }
part = "d5 . . . . . f5 . . . a5 . . . . . | . . . . f5 . . . . . . . . . . . | bb4 . . . . . d5 . . . f5 . . . . . | . . . . a5 . . . . . . . . . . ."

[[stem]]
name = "Pizzicato"
cue = "calm"
patch = "pluck"
fader = { follow = "rise", from = 0.2, to = 0.45 }
part = "r-12 . . r-5 . . r . r-12 . . 2 . . r-5 ."

[[stem]]
name = "Heartbeat"
cue = "calm"
patch = "heart"
fader = { follow = "rise", from = 0.4, to = 0.65 }
part = "g#1 f#1? . . . . . . g#1 f#1? . . . . . ."

[[stem]]
name = "Tremolo"
cue = "calm"
patch = "tremolo"
fader = { follow = "rise", from = 0.62, to = 0.92 }
part = "r+36,2+36,r+38 _*15"

# ── Stems: fight ────────────────────────────────────────────────────────────────

[[stem]]
name = "Low strings (fight)"
cue = "fight"
patch = "strings_bright"
level = 0.7
part = "r-12,r-5,r+12,2+12 _*15"

[[stem]]
name = "Impact"
cue = "fight"
patch = "brass"
once = true
level = 1.4
part = "d2,d3,eb3,a3,eb4 _*7 .*8"

[[stem]]
name = "Impact drum"
cue = "fight"
patch = "drum"
once = true
level = 0.9
part = "g#0! .*15"

[[stem]]
name = "Spiccato"
cue = "fight"
patch = "spiccato"
part = "r,r-12! r+1,r-11 r,r-12 r+12,r r,r-12! r+1,r-11 r,r-12 r+6,r-6 r,r-12! r+1,r-11 r,r-12 r+12,r r+7,r-5! r+6,r-6 r+1,r-11 r,r-12"

[[stem]]
name = "Low brass"
cue = "fight"
patch = "low_brass"
part = "r-12! _ _ r-12 _ . r-12 _ r-12! _ _ r-12 _ . r-12 _"

[[stem]]
name = "Brass stabs"
cue = "fight"
patch = "brass"
part = ". . . . . . r+7,r+12,2+12,r+13 _ . . . . . . . . | . . . . . . r+7,r+12,2+12,r+13 _ . . . . . . r+7,r+12,2+12,r+13! _"

[[stem]]
name = "War drums"
cue = "fight"
patch = "drum"
part = "X . . x . . x . X . . x . . x . | X . . x . . x . X . . x . . x . | X . . x . . x . X . . x . . x . | X . . x . . x . X . . x r-38 r-36 r-34 r-32"

[[stem]]
name = "Ticking"
cue = "fight"
patch = "tick"
part = ". x? . x . x? . x . x? . x . x? . x"

[[stem]]
name = "Riser"
cue = "fight"
patch = "riser"
level = 0.8
part = "2+24,2+25,2+30 _*63"

# ── Stems: win ──────────────────────────────────────────────────────────────────

[[stem]]
name = "Win brass"
cue = "win"
patch = "brass"
part = "ch,r+19 _*15 .*16"

[[stem]]
name = "Win strings"
cue = "win"
patch = "strings_bright"
part = "r-12,ch,r+24 _*19 .*12"

[[stem]]
name = "Win timpani"
cue = "win"
patch = "drum"
part = "r-12? r-12 r-12! .*29"

[[stem]]
name = "Win bells"
cue = "win"
patch = "bell"
part = ". . . d5 f#5 a5 d6 .*25"

# ── Stems: lose ─────────────────────────────────────────────────────────────────

[[stem]]
name = "Lose brass"
cue = "lose"
patch = "brass"
level = 1.2
part = "d2,eb2,bb2,a2 _*11 .*20"

[[stem]]
name = "Lose strings"
cue = "lose"
patch = "strings_dark"
part = "d1,d2,eb2 _*17 .*14"

[[stem]]
name = "Lose drum"
cue = "lose"
patch = "drum"
part = "c1! .*31"

[[stem]]
name = "Lose bell"
cue = "lose"
patch = "bell"
part = ".*15 eb5 .*16"

# ── Patches ─────────────────────────────────────────────────────────────────────

[patch.bell]
about = "Celesta: a sine with a faint inharmonic overtone."
osc = [{ wave = "sine" }, { wave = "sine", ratio = 4.01, level = 0.25 }]
attack = 0.003
decay = 1.8
sustain = 0.0
release = 0.3
gain = 0.07
send = 1.3

[patch.brass]
about = "Horns: the filter swells open on each note."
osc = [{ wave = "saw", cents = -5.0 }, { wave = "saw", cents = 5.0 }]
attack = 0.06
decay = 0.5
sustain = 1.0
release = 0.45
gain = 0.05
filter = { kind = "lowpass", cutoff = 500.0, q = 1.2, env = 2100.0, env_attack = 0.25, env_decay = 0.6 }

[patch.drum]
about = "War drum / timpani: a pitched thump with a skin of noise."
osc = [{ wave = "sine" }, { wave = "noise", level = 0.4 }]
attack = 0.003
decay = 0.55
sustain = 0.0
release = 0.1
gain = 0.9
hit = "r-24"
filter = { kind = "lowpass", cutoff = 500.0, q = 0.7 }
drop = 0.6
send = 0.6

[patch.heart]
about = "A low, soft thump: his pulse."
osc = [{ wave = "sine" }]
attack = 0.003
decay = 0.24
sustain = 0.0
release = 0.1
gain = 0.9
drop = 0.6
send = 0.3

[patch.low_brass]
about = "Distorted low brass: the fight's engine."
osc = [{ wave = "saw", cents = -8.0 }, { wave = "saw", cents = 8.0 }, { wave = "square", semis = -12.0 }]
attack = 0.008
decay = 0.25
sustain = 0.5
release = 0.12
gain = 0.08
drive = 3.5
filter = { kind = "lowpass", cutoff = 260.0, q = 2.0, env = 1200.0, env_decay = 0.18 }

[patch.pluck]
osc = [{ wave = "triangle" }, { wave = "sine", semis = 12.0 }]
attack = 0.004
decay = 0.32
sustain = 0.0
release = 0.1
gain = 0.22
filter = { kind = "lowpass", cutoff = 900.0, q = 0.7 }

[patch.riser]
about = "A cluster of tremolo strings that slides up a fifth over four bars."
osc = [{ wave = "saw", cents = -6.0 }, { wave = "saw", cents = 6.0 }]
attack = 6.5
decay = 1.0
sustain = 1.0
release = 0.1
gain = 0.07
filter = { kind = "bandpass", cutoff = 2600.0, q = 0.6 }
tremolo_rate = 15.0
tremolo_depth = 1.0
glide = 7.0

[patch.spiccato]
osc = [{ wave = "saw", cents = -7.0 }, { wave = "saw", cents = 7.0 }]
attack = 0.006
decay = 0.12
sustain = 0.0
release = 0.05
gain = 0.06
filter = { kind = "lowpass", cutoff = 2000.0, q = 0.7, env = 600.0, env_decay = 0.08 }

[patch.strings]
about = "A string section: three saws a few cents apart, slow bow."
osc = [{ wave = "saw", cents = -9.0 }, { wave = "saw" }, { wave = "saw", cents = 8.0 }]
attack = 0.7
decay = 1.0
sustain = 1.0
release = 1.4
gain = 0.07
filter = { kind = "lowpass", cutoff = 1100.0, q = 0.4 }

[patch.strings_bright]
osc = [{ wave = "saw", cents = -9.0 }, { wave = "saw" }, { wave = "saw", cents = 8.0 }]
attack = 0.5
decay = 1.0
sustain = 1.0
release = 1.4
gain = 0.06
filter = { kind = "lowpass", cutoff = 2200.0, q = 0.4 }

[patch.strings_dark]
osc = [{ wave = "saw", cents = -9.0 }, { wave = "saw" }, { wave = "saw", cents = 8.0 }]
attack = 0.3
decay = 1.0
sustain = 1.0
release = 1.4
gain = 0.08
filter = { kind = "lowpass", cutoff = 600.0, q = 0.4 }

[patch.tick]
osc = [{ wave = "noise" }]
attack = 0.001
decay = 0.05
sustain = 0.0
release = 0.02
gain = 0.22
filter = { kind = "highpass", cutoff = 6000.0, q = 0.7 }
send = 0.5

[patch.tremolo]
about = "High strings, bowed fast."
osc = [{ wave = "saw", cents = -6.0 }, { wave = "saw", cents = 6.0 }]
attack = 1.0
decay = 1.0
sustain = 1.0
release = 1.2
gain = 0.05
filter = { kind = "bandpass", cutoff = 2200.0, q = 0.7 }
tremolo_rate = 13.0
tremolo_depth = 1.0
