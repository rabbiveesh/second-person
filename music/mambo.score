# ── Patches ─────────────────────────────────────────────────────────────────────

[patch.bass]
about = "Baby bass: a round pluck that rings into the next chord (the tumbao anticipates it)."
osc = [{ wave = "sine" }, { wave = "triangle", level = 0.5 }]
attack = 0.006
decay = 0.9
sustain = 0.0
release = 0.1
gain = 0.45
filter = { kind = "lowpass", cutoff = 600.0, q = 0.8, env = 500.0, env_decay = 0.08 }
send = 0.3

[patch.clave]
about = "Two hardwood sticks: a short, high knock."
osc = [{ wave = "sine" }, { wave = "sine", ratio = 1.58, level = 0.3 }]
attack = 0.001
decay = 0.05
sustain = 0.0
release = 0.02
gain = 0.22
hit = "d#7"
filter = { kind = "bandpass", cutoff = 2500.0, q = 1.5 }
send = 0.7

[patch.conga]
about = "Conga: a skin thump that drops onto its pitch; accent a high note for the slap."
osc = [{ wave = "sine" }, { wave = "noise", level = 0.15 }]
attack = 0.002
decay = 0.2
sustain = 0.0
release = 0.05
gain = 0.3
hit = "c4"
filter = { kind = "lowpass", cutoff = 1800.0, q = 0.7 }
drop = 0.35
send = 0.5

[patch.piano]
about = "Montuno piano: bright attack, quick decay."
osc = [{ wave = "triangle" }, { wave = "sine", ratio = 2.0, level = 0.4 }, { wave = "saw", level = 0.2 }]
attack = 0.002
decay = 0.6
sustain = 0.0
release = 0.1
gain = 0.1
filter = { kind = "lowpass", cutoff = 1800.0, q = 0.7, env = 2500.0, env_decay = 0.12 }
send = 0.8

[patch.saxes]
about = "Baritone and tenor saxes: the riff under the trumpets."
osc = [{ wave = "saw", cents = -6.0 }, { wave = "square", cents = 6.0, level = 0.6 }]
attack = 0.015
decay = 0.12
sustain = 0.6
release = 0.06
gain = 0.08
drive = 1.8
filter = { kind = "lowpass", cutoff = 700.0, q = 1.4, env = 900.0, env_decay = 0.1 }

[patch.shell]
about = "Cascara: a stick on the timbale's shell."
osc = [{ wave = "noise" }, { wave = "sine", level = 0.5 }]
attack = 0.001
decay = 0.03
sustain = 0.0
release = 0.02
gain = 0.2
hit = "g6"
filter = { kind = "bandpass", cutoff = 3000.0, q = 1.8 }
send = 0.5

[patch.timbale]
about = "Timbale: a tight metal-rimmed drum that rings."
osc = [{ wave = "sine" }, { wave = "square", ratio = 1.51, level = 0.2 }, { wave = "noise", level = 0.25 }]
attack = 0.001
decay = 0.25
sustain = 0.0
release = 0.05
gain = 0.35
hit = "a4"
filter = { kind = "lowpass", cutoff = 3500.0, q = 0.9 }
drop = 0.2
send = 0.7

[patch.trombone]
about = "A trombone that sags as it holds: wah, wah, wah, waaah."
osc = [{ wave = "saw", cents = -5.0 }, { wave = "saw", cents = 5.0 }]
attack = 0.05
decay = 0.3
sustain = 0.8
release = 0.25
gain = 0.16
filter = { kind = "lowpass", cutoff = 500.0, q = 1.5, env = 900.0, env_attack = 0.1, env_decay = 0.4 }
tremolo_rate = 5.5
tremolo_depth = 0.35
glide = -0.7

[patch.trombones]
about = "Trombone section: warm and low, the filter pushes on each note."
osc = [{ wave = "saw", cents = -5.0 }, { wave = "saw", cents = 5.0 }]
attack = 0.03
decay = 0.25
sustain = 0.6
release = 0.15
gain = 0.05
filter = { kind = "lowpass", cutoff = 450.0, q = 1.1, env = 1300.0, env_decay = 0.2 }

[patch.trumpets]
about = "A trumpet section: bright, stabbing, the filter snaps open."
osc = [{ wave = "saw", cents = -6.0 }, { wave = "saw", cents = 6.0 }, { wave = "square", semis = 12.0, level = 0.2 }]
attack = 0.01
decay = 0.2
sustain = 0.5
release = 0.1
gain = 0.06
filter = { kind = "lowpass", cutoff = 900.0, q = 1.2, env = 3500.0, env_decay = 0.12 }

[patch.vibes]
about = "Vibraphone: soft bars with the motor's slow pulse."
osc = [{ wave = "sine" }, { wave = "sine", ratio = 3.98, level = 0.15 }]
attack = 0.004
decay = 1.4
sustain = 0.0
release = 0.3
gain = 0.14
tremolo_rate = 5.0
tremolo_depth = 0.35
send = 1.2
