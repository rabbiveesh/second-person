title = "Mambo"
layouts = ["yard"]
gain = 0.7
reverb = 0.28
room = 2.0

# ── Cues ────────────────────────────────────────────────────────────────────────

[[cue]]
name = "calm"
bpm = 92.0
chords = "Ebmaj7 Ebmaj7 Bmaj7 Bmaj7 Gmaj7 Gmaj7 Bb7 Bb7"
fade = 0.7

[[cue]]
name = "fight"
bpm = 144.0
chords = "Ebmaj7 F#7 Bmaj7 D7 Gmaj7 Bb7 Ebmaj7 Bb7"
fade = 0.05

[[cue]]
name = "win"
bpm = 144.0
chords = "Bb7 Ebmaj7"
fade = 0.3

[[cue]]
name = "lose"
bpm = 92.0
chords = "Ebm Ebm"
fade = 0.3

