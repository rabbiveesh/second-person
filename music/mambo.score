title = "Mambo"
layouts = ["yard"]
gain = 0.7
reverb = 0.22
room = 1.6

# ── Cues ────────────────────────────────────────────────────────────────────────

[[cue]]
name = "calm"
bpm = 100.0
chords = "Am Dm E7 Am"
fade = 0.7

[[cue]]
name = "fight"
bpm = 192.0
chords = "Am F7 E7 Am"
fade = 0.05

[[cue]]
name = "win"
bpm = 192.0
chords = "A6 A6"
fade = 0.3

[[cue]]
name = "lose"
bpm = 100.0
chords = "Am Am"
fade = 0.3

# ── Stems: calm ─────────────────────────────────────────────────────────────────

[[stem]]
name = "Bass"
cue = "calm"
patch = "bass"
part = ". . . . . . e2 . . . . . d2 . . . | . . . . . . a1 . . . . . e2 . . . | . . . . . . b1 . . . . . a1 . . . | . . . . . . e2 . . . . . a1 . . ."

[[stem]]
name = "Clave"
cue = "calm"
patch = "clave"
part = ". . . . x . . . x . . . . . . . | x . . . . . x . . . . . x . . ."

[[stem]]
name = "Vibes"
cue = "calm"
patch = "vibes"
fader = { follow = "fall", from = 0.2, to = 0.55 }
part = "e5 . . a5 . . c6 . b5 . a5 . . . . . | f5 . . a5 . . d6 . c6 . a5 . . . . . | g#5 . . b5 . . d6 . e6 _ _ _ d6 . b5 . | a5 _*7 . . e5 . . . . ."

[[stem]]
name = "Montuno"
cue = "calm"
patch = "piano"
fader = { follow = "rise", from = 0.12, to = 0.4 }
part = "r+12,r+24 . . . 2+12,2+24 . 3+12,3+24 . . . 2+12,2+24 . 3+12,3+24 . . ."

[[stem]]
name = "Congas"
cue = "calm"
patch = "conga"
fader = { follow = "rise", from = 0.3, to = 0.6 }
part = "c4? . c4? . e4! . c4? . c4? . c4? . c4 . g3 ."

[[stem]]
name = "Shaker"
cue = "calm"
patch = "shaker"
fader = { follow = "rise", from = 0.35, to = 0.65 }
part = "x? x? x x? x? x? x x? x? x? x x? x? x? x x?"

[[stem]]
name = "Bell"
cue = "calm"
patch = "cowbell"
fader = { follow = "rise", from = 0.55, to = 0.8 }
part = "X . . . x . x . X . . . x . x ."

[[stem]]
name = "Muted horns"
cue = "calm"
patch = "muted_horns"
fader = { follow = "rise", from = 0.62, to = 0.9 }
part = ". . . . . . . . . . ch+12! . . . ch+12 ."

# ── Stems: fight ────────────────────────────────────────────────────────────────

[[stem]]
name = "Mambo!"
cue = "fight"
patch = "trumpets"
once = true
level = 1.3
part = "ch+12,r+24! _*5 .*10 | .*48"

[[stem]]
name = "Timbale roll in"
cue = "fight"
patch = "timbale"
once = true
part = "x? x? x x x! .*11 | .*48"

[[stem]]
name = "Bass (fight)"
cue = "fight"
patch = "bass"
part = ". . . . . . e2 . . . . . f2 . . . | . . . . . . c2 . . . . . e2 . . . | . . . . . . b1 . . . . . a1 . . . | . . . . . . e2 . . . . . a1 . . ."

[[stem]]
name = "Montuno (fight)"
cue = "fight"
patch = "piano"
level = 1.1
part = "r+12,r+24! . 3+12,3+24 . 2+12,2+24 . 3+12,3+24! . . . 2+12,2+24 . 3+12,3+24! . r+12,r+24 ."

[[stem]]
name = "Clave (fight)"
cue = "fight"
patch = "clave"
part = ". . . . x . . . x . . . . . . . | x . . . . . x . . . . . x . . ."

[[stem]]
name = "Bell (fight)"
cue = "fight"
patch = "cowbell"
part = "X . x . x . x x X . x . x . x x"

[[stem]]
name = "Congas (fight)"
cue = "fight"
patch = "conga"
part = "c4? c4? e4! c4? c4? c4? c4 g3 c4? c4? e4! c4? c4 . c4 g3"

[[stem]]
name = "Cascara"
cue = "fight"
patch = "shell"
part = "X . x . X x . x X . x X . x X ."

[[stem]]
name = "Timbale fill"
cue = "fight"
patch = "timbale"
part = ".*16 | .*16 | .*16 | . . . . . . . . x? x x? x x x! . X"

[[stem]]
name = "Trumpets"
cue = "fight"
patch = "trumpets"
part = ". . . ch+12! . . ch+12 . . . ch+12! . . . . . | . . . . . . . . . . ch+12! . ch+12 . ch+12! ."

[[stem]]
name = "Saxes"
cue = "fight"
patch = "saxes"
part = "r! . r+3 . r+7 . r+10 . r+12! . r+10 . r+7 . r+3 ."

# ── Stems: win ──────────────────────────────────────────────────────────────────

[[stem]]
name = "Win horns"
cue = "win"
patch = "trumpets"
level = 1.2
part = "ch+12! . . ch+12 . . ch+12,r+24! _*9 | .*16"

[[stem]]
name = "Win bass"
cue = "win"
patch = "bass"
part = "r-12! . . r-12 . . r-12! .*9 | .*16"

[[stem]]
name = "Win timbales"
cue = "win"
patch = "timbale"
part = "X . . X . . X . . . . . . . . . | .*16"

[[stem]]
name = "Win piano"
cue = "win"
patch = "piano"
part = "ch+12! . . ch+12 . . ch+12,ch+24! .*9 | .*16"

# ── Stems: lose ─────────────────────────────────────────────────────────────────

[[stem]]
name = "Sad trombone"
cue = "lose"
patch = "trombone"
level = 1.2
part = "bb2 _*3 a2 _*3 g#2 _*3 g2 _*15 .*4"

[[stem]]
name = "Lose clave"
cue = "lose"
patch = "clave"
part = ".*28 x? . . ."

# ── Patches ─────────────────────────────────────────────────────────────────────

[patch.bass]
about = "Baby bass: a round pluck that rings into the next chord (the tumbao anticipates it)."
osc = [{ wave = "sine" }, { wave = "triangle", level = 0.5 }]
attack = 0.006
decay = 0.9
sustain = 0.0
release = 0.1
gain = 0.45
filter = { kind = "lowpass", cutoff = 600.0, q = 0.8, env = 500.0, env_decay = 0.08 }
send = 0.3

[patch.clave]
about = "Two hardwood sticks: a short, high knock."
osc = [{ wave = "sine" }, { wave = "sine", ratio = 1.58, level = 0.3 }]
attack = 0.001
decay = 0.05
sustain = 0.0
release = 0.02
gain = 0.22
hit = "d#7"
filter = { kind = "bandpass", cutoff = 2500.0, q = 1.5 }
send = 0.7

[patch.conga]
about = "Conga: a skin thump that drops onto its pitch; accent a high note for the slap."
osc = [{ wave = "sine" }, { wave = "noise", level = 0.15 }]
attack = 0.002
decay = 0.2
sustain = 0.0
release = 0.05
gain = 0.3
hit = "c4"
filter = { kind = "lowpass", cutoff = 1800.0, q = 0.7 }
drop = 0.35
send = 0.5

[patch.cowbell]
about = "Mambo bell: two square tones a fifth-ish apart, through a narrow band."
osc = [{ wave = "square" }, { wave = "square", ratio = 1.48 }]
attack = 0.001
decay = 0.14
sustain = 0.0
release = 0.03
gain = 0.07
hit = "c#5"
filter = { kind = "bandpass", cutoff = 900.0, q = 2.5 }
send = 0.5

[patch.muted_horns]
about = "Harmon-muted trumpets: nasal, held back."
osc = [{ wave = "square", cents = -4.0 }, { wave = "saw", cents = 4.0 }]
attack = 0.02
decay = 0.15
sustain = 0.3
release = 0.1
gain = 0.035
filter = { kind = "bandpass", cutoff = 1400.0, q = 3.0, env = 600.0, env_decay = 0.1 }

[patch.piano]
about = "Montuno piano: bright attack, quick decay."
osc = [{ wave = "triangle" }, { wave = "sine", ratio = 2.0, level = 0.4 }, { wave = "saw", level = 0.2 }]
attack = 0.002
decay = 0.6
sustain = 0.0
release = 0.1
gain = 0.1
filter = { kind = "lowpass", cutoff = 1800.0, q = 0.7, env = 2500.0, env_decay = 0.12 }
send = 0.8

[patch.saxes]
about = "Baritone and tenor saxes: the riff under the trumpets."
osc = [{ wave = "saw", cents = -6.0 }, { wave = "square", cents = 6.0, level = 0.6 }]
attack = 0.015
decay = 0.12
sustain = 0.6
release = 0.06
gain = 0.06
drive = 1.8
filter = { kind = "lowpass", cutoff = 700.0, q = 1.4, env = 900.0, env_decay = 0.1 }

[patch.shaker]
about = "Maracas: a burst of high noise."
osc = [{ wave = "noise" }]
attack = 0.004
decay = 0.04
sustain = 0.0
release = 0.02
gain = 0.12
filter = { kind = "highpass", cutoff = 5000.0, q = 0.7 }
send = 0.4

[patch.shell]
about = "Cascara: a stick on the timbale's shell."
osc = [{ wave = "noise" }, { wave = "sine", level = 0.5 }]
attack = 0.001
decay = 0.03
sustain = 0.0
release = 0.02
gain = 0.2
hit = "g6"
filter = { kind = "bandpass", cutoff = 3000.0, q = 1.8 }
send = 0.5

[patch.timbale]
about = "Timbale: a tight metal-rimmed drum that rings."
osc = [{ wave = "sine" }, { wave = "square", ratio = 1.51, level = 0.2 }, { wave = "noise", level = 0.25 }]
attack = 0.001
decay = 0.25
sustain = 0.0
release = 0.05
gain = 0.35
hit = "a4"
filter = { kind = "lowpass", cutoff = 3500.0, q = 0.9 }
drop = 0.2
send = 0.7

[patch.trombone]
about = "A trombone that sags as it holds: wah, wah, wah, waaah."
osc = [{ wave = "saw", cents = -5.0 }, { wave = "saw", cents = 5.0 }]
attack = 0.05
decay = 0.3
sustain = 0.8
release = 0.25
gain = 0.16
filter = { kind = "lowpass", cutoff = 500.0, q = 1.5, env = 900.0, env_attack = 0.1, env_decay = 0.4 }
tremolo_rate = 5.5
tremolo_depth = 0.35
glide = -0.7

[patch.trumpets]
about = "A trumpet section: bright, stabbing, the filter snaps open."
osc = [{ wave = "saw", cents = -6.0 }, { wave = "saw", cents = 6.0 }, { wave = "square", semis = 12.0, level = 0.2 }]
attack = 0.01
decay = 0.2
sustain = 0.5
release = 0.1
gain = 0.06
filter = { kind = "lowpass", cutoff = 900.0, q = 1.2, env = 3500.0, env_decay = 0.12 }

[patch.vibes]
about = "Vibraphone: soft bars with the motor's slow pulse."
osc = [{ wave = "sine" }, { wave = "sine", ratio = 3.98, level = 0.15 }]
attack = 0.004
decay = 1.4
sustain = 0.0
release = 0.3
gain = 0.08
tremolo_rate = 5.0
tremolo_depth = 0.35
send = 1.2
