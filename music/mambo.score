title = "Mambo"
layouts = ["yard"]
gain = 0.7
reverb = 0.28
room = 2.0

# ── Cues ────────────────────────────────────────────────────────────────────────

[[cue]]
name = "calm"
bpm = 92.0
chords = "Ebmaj7 Ebmaj7 Bmaj7 Bmaj7"
fade = 0.7

[[cue]]
name = "fight"
bpm = 112.0
chords = "Ebmaj7 Ebmaj7 Bmaj7 Bmaj7"
fade = 0.05

[[cue]]
name = "win"
bpm = 112.0
chords = "Bb7 Ebmaj7"
fade = 0.3

[[cue]]
name = "lose"
bpm = 92.0
chords = "Ebm Ebm"
fade = 0.3

# ── Stems: calm ─────────────────────────────────────────────────────────────────

[[stem]]
name = "Bass"
cue = "calm"
patch = "bass"
part = ". . . . . . bb1 . . . . . eb2 . . . | . . . . . . bb1 . . . . . b1 . . . | . . . . . . f#2 . . . . . b1 . . . | . . . . . . f#2 . . . . . eb2 . . ."

[[stem]]
name = "Clave"
cue = "calm"
patch = "clave"
part = ". . . . x . . . x . . . . . . . | x . . . . . x . . . . . x . . ."

[[stem]]
name = "Vibes"
cue = "calm"
patch = "vibes"
part = "g5 . . bb5 . . d6 .*9 | c6 . . bb5 . . g5 _*9 | f#5 . . a#5 . . d#6 .*9 | c#6 . . a#5 . . f#5 _*9"

[[stem]]
name = "Montuno"
cue = "calm"
patch = "piano"
fader = { follow = "rise", from = 0.12, to = 0.4 }
part = "2+12,4+12 . . . 1+12,3+12 . 2+12,4+12 . . . 1+12,3+12 . 2+12,4+12 . . ."

[[stem]]
name = "Congas"
cue = "calm"
patch = "conga"
fader = { follow = "rise", from = 0.3, to = 0.6 }
part = "c4? . c4? . e4! . c4? . c4? . c4? . c4 . g3 ."

[[stem]]
name = "Cascara"
cue = "calm"
patch = "shell"
fader = { follow = "rise", from = 0.55, to = 0.8 }
part = "X . x . X x . x X . x X . x X ."

[[stem]]
name = "Timbales"
cue = "calm"
patch = "timbale"
fader = { follow = "rise", from = 0.7, to = 0.95 }
part = ". . . . . . . . . . . . a4? a4 e4 . | .*16 | . . . . . . . . . . . . a4? a4 e4 e4! | .*16"

